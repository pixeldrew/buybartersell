{
  "name": "buybartersell",
  "version": "1.0.0",
  "description": "WhatsApp group messaging bot with REST API and invite-link moderation",
  "workspaces": [
    "client/admin",
    "client/join",
    "client/ui"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:admin && npm run build:join",
    "build:server": "tsc",
    "build:admin": "npm --workspace buybartersell-admin run build",
    "build:join": "npm --workspace buybartersell-join run build",
    "start": "node dist/index.js",
    "dev": "ts-node --project tsconfig.json src/index.ts",
    "dev:admin": "npm --workspace buybartersell-admin run dev",
    "dev:join": "npm --workspace buybartersell-join run dev",
    "prepare": "husky"
  },
  "module": "dist/index.js",
  "keywords": [
    "whatsapp",
    "moderation"
  ],
  "author": "Drew Foehn <drew@foe.hn>",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "dotenv-flow": "^4.1.0",
    "express": "^5.2.1",
    "express-openid-connect": "^2.20.2",
    "mongoose": "^9.4.1",
    "node-cache": "^5.1.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/node-cache": "^4.1.3",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "semantic-release": "^25.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
